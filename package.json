{
  "name": "@thinkingai/ae-cli",
  "version": "6.0.38",
  "description": "CLI tool for ThinkingAI (AE) analytics platform",
  "type": "module",
  "bin": {
    "ae-cli": "bin/ae-cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "bin/",
    "dist/",
    "skills/",
    "wiki/",
    "tracking-plan-template/",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --outDir dist && node scripts/copy-tracking-assets.mjs",
    "generate:analysis-skill": "tsx scripts/generate-analysis-skill-index.mts",
    "verify:config": "node test/config-commands.test.mjs",
    "verify:json-utils": "npx tsx tests/json-utils.test.ts",
    "verify:jq-output": "npx tsx test/jq-output.test.mjs",
    "verify:analysis-tools": "tsx scripts/verify-te-analysis-tools.mjs",
    "verify:analysis-skill": "tsx scripts/generate-analysis-skill-index.mts --check",
    "verify:analysis-four-modules": "tsx tests/analysis-report-capability-command.test.ts && tsx tests/analysis-export-flow-command.test.ts && tsx tests/analysis-dashboard-audience-contract.test.ts",
    "verify:analysis-contract-regressions": "tsx test/analysis-contract-regressions.test.mjs && tsx tests/analysis-sql-special-identifiers.test.ts",
    "verify:analysis-agent-contract": "tsx tests/analysis-agent-skill-contract.test.ts",
    "verify:output-contract": "tsx tests/output-contract.test.ts",
    "verify:analysis-cluster-routing": "node scripts/verify-analysis-cluster-routing.mjs",
    "verify:multi-cluster-mode": "node test/multi-cluster-mode.test.mjs",
    "verify:metadata-capability": "npx tsx test/metadata-capability-commands.test.mjs",
    "verify:community-capability": "node test/community-capability-routing.test.mjs",
    "verify:community-report": "npx tsx tests/community-report-standard-v5.test.ts && npx tsx tests/community-report-client.test.ts && npx tsx tests/community-report-framework.test.ts && npx tsx tests/community-data-report-command.test.ts && node test/community-data-report-skill.test.mjs",
    "verify:engage-capability": "tsx test/engage/engage-capability-command.test.mjs && node test/engage/engage-skill-capability.test.mjs",
    "verify:retired-analysis-commands": "node --test test/retired-analysis-commands.test.mjs",
    "verify:analysis-meta-tools": "node scripts/verify-te-meta-tools.mjs",
    "verify:analysis-common-tools": "node scripts/verify-te-common-tools.mjs",
    "verify:team-tools": "node scripts/verify-te-team-tools.mjs",
    "verify:agent-tools": "node scripts/verify-agent-tools.mjs && npm run verify:sandbox-tools",
    "verify:system-tools": "node scripts/verify-system-tools.mjs && npx tsx tests/system-domain.test.ts && npx tsx tests/sandbox-tool-package.test.ts",
    "verify:sandbox-tools": "tsx test/sandbox-tools.test.ts",
    "verify:tracking-tools": "tsx test/tracking-client.test.mjs && tsx test/tracking-skill-flow.test.mjs && node test/tracking-commands.test.mjs && tsx tests/tracking-display-name-sync.test.ts",
    "verify:self-check-overlay": "node test/self-check-overlay.test.mjs",
    "verify:update-check": "npx tsx test/update-check.test.mjs",
    "verify:version-sync": "npx tsx tests/version-sync.test.ts",
    "qa-changed": "node scripts/qa-changed.mjs",
    "self-check": "node self-check/scan.mjs",
    "check:release": "node self-check/release-gate.mjs",
    "sync:skills-to-system": "node scripts/sync-skills-to-system.mjs",
    "verify:system-skills-sync": "node --test test/sync-system-skills.test.mjs",
    "check:agents-docs": "node scripts/check-agents-docs-sync.mjs",
    "prepublishOnly": "npm run check:release && npm run build",
    "start": "node dist/index.js",
    "test": "npx tsx src/index.ts --help && npm run verify:sandbox-tools"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ThinkingAIAgenticEngine/ae-cli.git"
  },
  "keywords": [
    "thinkingengine",
    "analytics",
    "cli"
  ],
  "author": "ThinkingData",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@types/json-bigint": "^1.0.4",
    "archiver": "^5.3.2",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "exceljs": "^4.4.0",
    "jq-wasm": "^3.0.0-jq-1.8.2",
    "json-bigint": "^1.0.0",
    "turndown": "^7.2.4",
    "undici": "^6.19.0",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/archiver": "^5.3.4",
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.5.0",
    "jszip": "^3.10.1",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  }
}
