  "experimentTypes": {
    "item-coupon": {
      "audience": {
        "bucketId": "#account_id",
        "viewEvent": "item_detail_view",
        "minimumViewDays": 2,
        "excludeEvent": "payment_success"
      },
      "durationDays": 7,
      "allocation": 100,
      "currency": "CNY",
      "costPerPaidOrder": 50,
      "otherCosts": 0,
      "arms": {
        "control": {
          "featureValue": "full_price",
          "allocation": 50,
          "price": 100,
          "exposureLimit": 12,
          "couponClaims": 0,
          "paidUsers": 1,
          "name": "Full-price reminder"
        },
        "treatment": {
          "featureValue": "coupon_20",
          "allocation": 50,
          "price": 80,
          "exposureLimit": 12,
          "couponClaims": 8,
          "paidUsers": 7,
          "name": "20% coupon"
        }
      },
      "events": {
        "exposure": "te_experiment_exposure",
        "couponClaim": "demo_coupon_claim",
        "payment": "payment_success"
      },
      "exposureProperties": [
        [
          "experiment_id",
          "string",
          "#experiment_id"
        ],
        [
          "experiment_group_id",
          "string",
          "#experiment_group_id"
        ],
        [
          "is_control_group",
          "boolean",
          "#is_control_group"
        ]
      ],
      "metrics": [
        {
          "role": "primary",
          "event": "payment_success",
          "aggregation": "user_count",
          "format": "integer"
        },
        {
          "role": "secondary",
          "event": "payment_success",
          "aggregation": "sum",
          "property": "amount",
          "format": "float2"
        }
      ],
      "metricFilters": [
        "plg_sample_id",
        "item_id"
      ],
      "runFilter": "demo_run_id",
      "orderKey": "order_id",
      "feature": {
        "type": "string",
        "targetPlatform": [
          "client"
        ],
        "keyPrefix": "plg_offer",
        "displayName": "Demo offer"
      },
      "experiment": {
        "name": "Demo offer A/B",
        "hypothesis": "An item-specific 20% coupon increases the number of buyers.",
        "atlasType": "feature"
      }
    },
    "checkout-recovery": {
      "audience": {
        "bucketId": "#account_id",
        "viewEvent": "item_detail_view",
        "minimumViewDays": 1,
        "checkoutEvent": "checkout_start",
        "excludeEvent": "payment_success"
      },
      "durationDays": 7,
      "allocation": 100,
      "currency": "CNY",
      "costPerPaidOrder": 50,
      "otherCosts": 0,
      "arms": {
        "control": {
          "featureValue": "product_details",
          "allocation": 50,
          "price": 100,
          "paidUsers": 2,
          "name": "Reminder to product details"
        },
        "treatment": {
          "featureValue": "direct_checkout",
          "allocation": 50,
          "price": 100,
          "paidUsers": 4,
          "name": "Reminder directly to checkout"
        }
      },
      "events": {
        "exposure": "te_experiment_exposure",
        "payment": "payment_success"
      },
      "exposureProperties": [
        ["experiment_id", "string", "#experiment_id"],
        ["experiment_group_id", "string", "#experiment_group_id"],
        ["is_control_group", "boolean", "#is_control_group"]
      ],
      "metrics": [
        {
          "role": "primary",
          "event": "payment_success",
          "aggregation": "user_count",
          "format": "integer"
        },
        {
          "role": "secondary",
          "event": "payment_success",
          "aggregation": "sum",
          "property": "amount",
          "format": "float2"
        }
      ],
      "metricFilters": [
        "plg_sample_id",
        "item_id"
      ],
      "runFilter": "demo_run_id",
      "orderKey": "order_id",
      "feature": {
        "type": "string",
        "targetPlatform": ["client"],
        "keyPrefix": "plg_checkout",
        "displayName": "Demo checkout recovery"
      },
      "experiment": {
        "name": "Demo checkout recovery A/B",
        "hypothesis": "At the same price, sending checkout abandoners directly to checkout increases the number of buyers.",
        "atlasType": "feature"
      }
    }
  }
}
